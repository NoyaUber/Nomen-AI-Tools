  "firestore": {
    "/profiles/{userId}": {
      "schema": "Profile",
      "description": "Private user profiles keyed by Firebase Auth UID."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Author writing projects."
    },
    "/entities/{entityId}": {
      "schema": "Entity",
      "description": "Fictional entities belonging to a project."
    },
    "/entity_relations/{relationId}": {
      "schema": "EntityRelation",
      "description": "Relationships between fictional entities."
    },
    "/lore_entries/{loreId}": {
      "schema": "LoreEntry",
      "description": "Lore and historical documents."
    },
    "/timeline_events/{eventId}": {
      "schema": "TimelineEvent",
      "description": "Chronological timeline events."
    },
    "/naming_rules/{ruleId}": {
      "schema": "NamingRule",
      "description": "Custom naming conventions per project."
    },
    "/ai_generations/{generationId}": {
      "schema": "AiGeneration",
      "description": "History of AI naming and worldbuilding generations."
    },
    "/favorites/{favoriteId}": {
      "schema": "Favorite",
      "description": "Favorited name candidates and generated items."
    },
    "/entity_versions/{versionId}": {
      "schema": "EntityVersion",
      "description": "Version snapshots for entities, lore, and timeline events."
    },
    "/project_ai_settings/{settingId}": {
      "schema": "ProjectAiSetting",
      "description": "Custom AI instructions per project."
    },
    "/trash_items/{trashId}": {
      "schema": "TrashItem",
      "description": "Soft-deleted project records."
    },
    "/activity_logs/{activityId}": {
      "schema": "ActivityLog",
      "description": "Project activity audit trail."
    },
    "/visual_assets/{assetId}": {
      "schema": "VisualAsset",
      "description": "Project visual assets, portraits, illustrations, maps, emblems, and novel covers."
    }
  }
}

