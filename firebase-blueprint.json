{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Private user profile for a worldbuilding studio author.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "Author display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Author email address (PII, owner-restricted)."
        },
        "defaultGenre": {
          "type": "string",
          "maxLength": 80,
          "description": "Preferred writing genre."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["ownerId", "displayName", "email", "defaultGenre", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "An isolated fictional universe or writing project.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "genre": {
          "type": "string",
          "maxLength": 100
        },
        "worldSettings": {
          "type": "string",
          "maxLength": 6000
        },
        "language": {
          "type": "string",
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "title", "description", "genre", "worldSettings", "language", "status", "createdAt", "updatedAt"]
    },
    "Entity": {
      "title": "Entity",
      "description": "A canonical worldbuilding entity (character, location, organization, item, ability, etc.).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "projectId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["character", "location", "organization", "family", "item", "ability", "species", "civilization", "custom"],
          "maxLength": 40
        },
        "subCategory": {
          "type": "string",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subtitle": {
          "type": "string",
          "maxLength": 300
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "parentId": {
          "type": "string",
          "maxLength": 128
        },
        "attributes": {
          "type": "object",
          "description": "Category-specific structured attributes map."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "projectId", "category", "subCategory", "name", "subtitle", "summary", "parentId", "attributes", "createdAt", "updatedAt"]
    },
    "EntityRelation": {
      "title": "EntityRelation",
