rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function ownsProject(projectId) {
      return isValidId(projectId)
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    // Validation Blueprints
    function isValidProfile(data) {
      return data.keys().hasAll(['ownerId', 'displayName', 'email', 'defaultGenre', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'email', 'defaultGenre', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.defaultGenre is string && data.defaultGenre.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['ownerId', 'title', 'description', 'genre', 'worldSettings', 'language', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'description', 'genre', 'worldSettings', 'language', 'status', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 4000
        && data.genre is string && data.genre.size() <= 100
        && data.worldSettings is string && data.worldSettings.size() <= 6000
        && data.language is string && data.language.size() <= 60
        && data.status is string && data.status.size() <= 20 && (data.status == 'active' || data.status == 'archived')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEntity(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'category', 'subCategory', 'name', 'subtitle', 'summary', 'parentId', 'attributes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'category', 'subCategory', 'name', 'subtitle', 'summary', 'parentId', 'attributes', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && isValidId(data.projectId)
        && data.category is string && data.category.size() <= 40
        && (data.category == 'character' || data.category == 'location' || data.category == 'organization' || data.category == 'family' || data.category == 'item' || data.category == 'ability' || data.category == 'species' || data.category == 'civilization' || data.category == 'custom')
        && data.subCategory is string && data.subCategory.size() <= 100
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.subtitle is string && data.subtitle.size() <= 300
        && data.summary is string && data.summary.size() <= 4000
        && data.parentId is string && data.parentId.size() <= 128
        && data.attributes is map && data.attributes.size() <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEntityRelation(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'sourceEntityId', 'sourceEntityName', 'targetEntityId', 'targetEntityName', 'relationType', 'description', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'sourceEntityId', 'sourceEntityName', 'targetEntityId', 'targetEntityName', 'relationType', 'description', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && isValidId(data.projectId)
        && isValidId(data.sourceEntityId)
        && data.sourceEntityName is string && data.sourceEntityName.size() >= 1 && data.sourceEntityName.size() <= 200
        && isValidId(data.targetEntityId)
        && data.targetEntityName is string && data.targetEntityName.size() >= 1 && data.targetEntityName.size() <= 200
        && data.relationType is string && data.relationType.size() >= 1 && data.relationType.size() <= 120
        && data.description is string && data.description.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLoreEntry(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'title', 'category', 'era', 'summary', 'content', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'title', 'category', 'era', 'summary', 'content', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && isValidId(data.projectId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.era is string && data.era.size() <= 120
        && data.summary is string && data.summary.size() <= 2000
        && data.content is string && data.content.size() <= 20000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTimelineEvent(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'title', 'dateLabel', 'sortOrder', 'era', 'category', 'locationName', 'participants', 'description', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'title', 'dateLabel', 'sortOrder', 'era', 'category', 'locationName', 'participants', 'description', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && isValidId(data.projectId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && data.dateLabel is string && data.dateLabel.size() >= 1 && data.dateLabel.size() <= 120
        && (data.sortOrder is int || data.sortOrder is float)
        && data.era is string && data.era.size() <= 120
        && data.category is string && data.category.size() <= 80
        && data.locationName is string && data.locationName.size() <= 200
        && data.participants is string && data.participants.size() <= 1000
        && data.description is string && data.description.size() <= 6000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNamingRule(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'title', 'category', 'cultureOrGroup', 'phoneticPattern', 'prefixSuffixRule', 'structureRule', 'examples', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'title', 'category', 'cultureOrGroup', 'phoneticPattern', 'prefixSuffixRule', 'structureRule', 'examples', 'isActive', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && isValidId(data.projectId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.cultureOrGroup is string && data.cultureOrGroup.size() <= 160
        && data.phoneticPattern is string && data.phoneticPattern.size() <= 1000
        && data.prefixSuffixRule is string && data.prefixSuffixRule.size() <= 1000
        && data.structureRule is string && data.structureRule.size() <= 1000
        && data.examples is string && data.examples.size() <= 1000
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiGeneration(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'generationType', 'category', 'promptSummary', 'resultsSummary', 'modelUsed', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'generationType', 'category', 'promptSummary', 'resultsSummary', 'modelUsed', 'createdAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && isValidId(data.projectId)
        && data.generationType is string && data.generationType.size() >= 1 && data.generationType.size() <= 60
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.promptSummary is string && data.promptSummary.size() <= 2000
        && data.resultsSummary is string && data.resultsSummary.size() <= 8000
        && data.modelUsed is string && data.modelUsed.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'name', 'pronunciation', 'category', 'interpretation', 'inspiration', 'suitability', 'titleOrVariation', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'name', 'pronunciation', 'category', 'interpretation', 'inspiration', 'suitability', 'titleOrVariation', 'createdAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && isValidId(data.projectId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.pronunciation is string && data.pronunciation.size() <= 200
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.interpretation is string && data.interpretation.size() <= 2000
        && data.inspiration is string && data.inspiration.size() <= 2000
        && data.suitability is string && data.suitability.size() <= 2000
        && data.titleOrVariation is string && data.titleOrVariation.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidEntityVersion(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'targetId', 'targetType', 'targetName', 'versionNumber', 'changeSummary', 'snapshot', 'authorName', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'targetId', 'targetType', 'targetName', 'versionNumber', 'changeSummary', 'snapshot', 'authorName', 'createdAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && isValidId(data.projectId)
        && isValidId(data.targetId)
        && data.targetType is string && data.targetType.size() <= 40
        && (data.targetType == 'entity' || data.targetType == 'lore' || data.targetType == 'timeline')
        && data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 240
        && (data.versionNumber is int || data.versionNumber is float)
        && data.changeSummary is string && data.changeSummary.size() <= 500
        && data.snapshot is map && data.snapshot.size() <= 60
        && data.authorName is string && data.authorName.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidProjectAiSetting(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'instructions', 'isEnabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'instructions', 'isEnabled', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && isValidId(data.projectId)
        && data.instructions is string && data.instructions.size() <= 6000
        && data.isEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrashItem(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'originalId', 'itemType', 'category', 'subCategory', 'name', 'summary', 'snapshot', 'deletedAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'originalId', 'itemType', 'category', 'subCategory', 'name', 'summary', 'snapshot', 'deletedAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && isValidId(data.projectId)
        && isValidId(data.originalId)
        && data.itemType is string && data.itemType.size() <= 40
        && (data.itemType == 'entity' || data.itemType == 'lore' || data.itemType == 'timeline')
        && data.category is string && data.category.size() <= 80
        && data.subCategory is string && data.subCategory.size() <= 100
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 240
        && data.summary is string && data.summary.size() <= 2000
        && data.snapshot is map && data.snapshot.size() <= 60
        && data.deletedAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'actionType', 'targetType', 'targetName', 'details', 'actorName', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'actionType', 'targetType', 'targetName', 'details', 'actorName', 'createdAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && isValidId(data.projectId)
        && data.actionType is string && data.actionType.size() >= 1 && data.actionType.size() <= 80
        && data.targetType is string && data.targetType.size() <= 80
        && data.targetName is string && data.targetName.size() <= 240
        && data.details is string && data.details.size() <= 1000
        && data.actorName is string && data.actorName.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidVisualAsset(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'entityId', 'entityType', 'entityName', 'assetCategory', 'subRole', 'fileName', 'mimeType', 'fileSize', 'width', 'height', 'storagePath', 'publicUrl', 'description', 'metadataJson', 'isPrimary', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'entityId', 'entityType', 'entityName', 'assetCategory', 'subRole', 'fileName', 'mimeType', 'fileSize', 'width', 'height', 'storagePath', 'publicUrl', 'description', 'metadataJson', 'isPrimary', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && isValidId(data.projectId)
        && data.entityId is string && data.entityId.size() <= 128
        && data.entityType is string && data.entityType.size() <= 80
        && data.entityName is string && data.entityName.size() <= 240
        && data.assetCategory is string && data.assetCategory.size() <= 60
        && (data.assetCategory == 'character_portrait' || data.assetCategory == 'character_illustration' || data.assetCategory == 'location_illustration' || data.assetCategory == 'kingdom_civilization' || data.assetCategory == 'kingdom_illustration' || data.assetCategory == 'organization_emblem' || data.assetCategory == 'weapon_artifact' || data.assetCategory == 'armor_equipment' || data.assetCategory == 'magic_ability' || data.assetCategory == 'power_system_illustration' || data.assetCategory == 'power_system' || data.assetCategory == 'world_map' || data.assetCategory == 'novel_cover' || data.assetCategory == 'general_reference' || data.assetCategory == 'visual_reference')
        && data.subRole is string && data.subRole.size() <= 120
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 255
        && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 80
        && (data.fileSize is int || data.fileSize is float) && data.fileSize >= 0 && data.fileSize <= 20971520
        && (data.width is int || data.width is float) && data.width >= 0 && data.width <= 16384
        && (data.height is int || data.height is float) && data.height >= 0 && data.height <= 16384
        && data.storagePath is string && data.storagePath.size() >= 1 && data.storagePath.size() <= 500
        && data.publicUrl is string && data.publicUrl.size() >= 1 && data.publicUrl.size() <= 2000
        && data.description is string && data.description.size() <= 4000
        && data.metadataJson is string && data.metadataJson.size() <= 12000
        && data.isPrimary is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 1. PROFILES (PII Isolated to strict owner)
    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidProfile(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'defaultGenre', 'updatedAt']);
      allow delete: if false;
    }

    // 2. PROJECTS
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(projectId)
        && isValidProject(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(projectId)
        && isValidProject(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Edit Project Metadata
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'genre', 'worldSettings', 'language', 'status', 'updatedAt'])
        );
      allow delete: if isVerifiedUser() && isValidId(projectId) && existing().ownerId == request.auth.uid;
    }

    // 3. ENTITIES
    match /entities/{entityId} {
      allow get: if isSignedIn() && isValidId(entityId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(entityId)
        && isValidEntity(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsProject(incoming().projectId);
      allow update: if isVerifiedUser()
        && isValidId(entityId)
        && isValidEntity(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Edit Entity Details
          incoming().diff(existing()).affectedKeys().hasOnly(['category', 'subCategory', 'name', 'subtitle', 'summary', 'parentId', 'attributes', 'updatedAt'])
        )
        && ownsProject(existing().projectId);
      allow delete: if isVerifiedUser()
        && isValidId(entityId)
        && existing().ownerId == request.auth.uid
        && ownsProject(existing().projectId);
    }

    // 4. ENTITY RELATIONS
    match /entity_relations/{relationId} {
      allow get: if isSignedIn() && isValidId(relationId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(relationId)
        && isValidEntityRelation(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsProject(incoming().projectId);
      allow update: if isVerifiedUser()
        && isValidId(relationId)
        && isValidEntityRelation(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update Relation Details
          incoming().diff(existing()).affectedKeys().hasOnly(['sourceEntityId', 'sourceEntityName', 'targetEntityId', 'targetEntityName', 'relationType', 'description', 'updatedAt'])
        )
        && ownsProject(existing().projectId);
      allow delete: if isVerifiedUser()
        && isValidId(relationId)
        && existing().ownerId == request.auth.uid
        && ownsProject(existing().projectId);
    }

    // 5. LORE ENTRIES
    match /lore_entries/{loreId} {
      allow get: if isSignedIn() && isValidId(loreId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(loreId)
        && isValidLoreEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsProject(incoming().projectId);
      allow update: if isVerifiedUser()
        && isValidId(loreId)
        && isValidLoreEntry(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Edit Lore Chronicle
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'era', 'summary', 'content', 'updatedAt'])
        )
        && ownsProject(existing().projectId);
      allow delete: if isVerifiedUser()
        && isValidId(loreId)
        && existing().ownerId == request.auth.uid
        && ownsProject(existing().projectId);
    }

    // 6. TIMELINE EVENTS
    match /timeline_events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(eventId)
        && isValidTimelineEvent(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsProject(incoming().projectId);
      allow update: if isVerifiedUser()
        && isValidId(eventId)
        && isValidTimelineEvent(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Edit Timeline Event
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'dateLabel', 'sortOrder', 'era', 'category', 'locationName', 'participants', 'description', 'updatedAt'])
        )
        && ownsProject(existing().projectId);
      allow delete: if isVerifiedUser()
        && isValidId(eventId)
        && existing().ownerId == request.auth.uid
        && ownsProject(existing().projectId);
    }

    // 7. NAMING RULES
    match /naming_rules/{ruleId} {
      allow get: if isSignedIn() && isValidId(ruleId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(ruleId)
        && isValidNamingRule(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsProject(incoming().projectId);
      allow update: if isVerifiedUser()
        && isValidId(ruleId)
        && isValidNamingRule(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Edit Naming Rule or Toggle Active
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'cultureOrGroup', 'phoneticPattern', 'prefixSuffixRule', 'structureRule', 'examples', 'isActive', 'updatedAt'])
        )
        && ownsProject(existing().projectId);
      allow delete: if isVerifiedUser()
        && isValidId(ruleId)
        && existing().ownerId == request.auth.uid
        && ownsProject(existing().projectId);
    }

    // 8. AI GENERATIONS (Immutable Audit Log per Project)
    match /ai_generations/{generationId} {
      allow get: if isSignedIn() && isValidId(generationId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(generationId)
        && isValidAiGeneration(incoming())
        && incoming().createdAt == request.time
        && ownsProject(incoming().projectId);
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(generationId)
        && existing().ownerId == request.auth.uid
        && ownsProject(existing().projectId);
    }

    // 9. FAVORITES
    match /favorites/{favoriteId} {
      allow get: if isSignedIn() && isValidId(favoriteId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(favoriteId)
        && isValidFavorite(incoming())
        && incoming().createdAt == request.time
        && ownsProject(incoming().projectId);
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(favoriteId)
        && existing().ownerId == request.auth.uid
        && ownsProject(existing().projectId);
    }

    // 10. ENTITY VERSIONS (Immutable Version History Snapshots)
    match /entity_versions/{versionId} {
      allow get: if isSignedIn() && isValidId(versionId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(versionId)
        && isValidEntityVersion(incoming())
        && incoming().createdAt == request.time
        && ownsProject(incoming().projectId);
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(versionId)
        && existing().ownerId == request.auth.uid
        && ownsProject(existing().projectId);
    }

    // 11. PROJECT AI SETTINGS (Custom AI Instructions per Project)
    match /project_ai_settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(settingId)
        && isValidProjectAiSetting(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsProject(incoming().projectId);
      allow update: if isVerifiedUser()
        && isValidId(settingId)
        && isValidProjectAiSetting(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update Custom AI Instructions or Toggle Enabled
          incoming().diff(existing()).affectedKeys().hasOnly(['instructions', 'isEnabled', 'updatedAt'])
        )
        && ownsProject(existing().projectId);
      allow delete: if isVerifiedUser()
        && isValidId(settingId)
        && existing().ownerId == request.auth.uid
        && ownsProject(existing().projectId);
    }

    // 12. TRASH ITEMS (Soft-Deleted Project Records)
    match /trash_items/{trashId} {
      allow get: if isSignedIn() && isValidId(trashId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(trashId)
        && isValidTrashItem(incoming())
        && incoming().deletedAt == request.time
        && ownsProject(incoming().projectId);
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(trashId)
        && existing().ownerId == request.auth.uid
        && ownsProject(existing().projectId);
    }

    // 13. ACTIVITY LOGS (Immutable Project Audit Trail)
    match /activity_logs/{activityId} {
      allow get: if isSignedIn() && isValidId(activityId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(activityId)
        && isValidActivityLog(incoming())
        && incoming().createdAt == request.time
        && ownsProject(incoming().projectId);
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(activityId)
        && existing().ownerId == request.auth.uid
        && ownsProject(existing().projectId);
    }

    // 14. VISUAL ASSETS (Phase 11 — Portraits, Illustrations, Maps, Emblems & Covers)
    match /visual_assets/{assetId} {
      allow get: if isSignedIn() && isValidId(assetId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(assetId)
        && isValidVisualAsset(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsProject(incoming().projectId);
      allow update: if isVerifiedUser()
        && isValidId(assetId)
        && isValidVisualAsset(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Edit Asset Metadata, Primary Status, or Replace File Reference
          incoming().diff(existing()).affectedKeys().hasOnly(['entityId', 'entityType', 'entityName', 'fileName', 'assetCategory', 'subRole', 'storagePath', 'publicUrl', 'mimeType', 'fileSize', 'width', 'height', 'description', 'metadataJson', 'isPrimary', 'updatedAt'])
        )
        && ownsProject(existing().projectId);
      allow delete: if isVerifiedUser()
        && isValidId(assetId)
        && existing().ownerId == request.auth.uid
        && ownsProject(existing().projectId);
    }
  }
}
